{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ · %@" : {
      "comment" : "A label displaying the duration and file size of a video clip. The first argument is the duration of the video clip. The second argument is the file size of the video clip.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@，%@" : {
      "comment" : "A label that describes the video's duration and file size. The first argument is the duration of the video. The second argument is the file size of the video.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@，%2$@"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A label displaying a number and its unit. The argument is the number, the second is the unit.",
      "isCommentAutoGenerated" : true
    },
    "%lld/%lld" : {
      "comment" : "A label showing the current video index and total count of videos.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld/%2$lld"
          }
        }
      }
    },
    "%lld%%" : {
      "comment" : "A label showing the progress of a video processing task. The value is a percentage between 0 and 1.",
      "isCommentAutoGenerated" : true
    },
